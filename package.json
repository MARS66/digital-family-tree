{
  "name": "digital-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digital family archive WeChat Mini Program monorepo",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "miniprogram",
    "server",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "dev:miniprogram": "npm run dev --workspace @digital-family-tree/miniprogram",
    "dev:server": "npm run dev --workspace @digital-family-tree/server",
    "start:server": "npm run start --workspace @digital-family-tree/server",
    "smoke:start": "npm run start:smoke --workspace @digital-family-tree/server",
    "lint": "npm run db:generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run tests/database",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
