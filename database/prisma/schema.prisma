generator client {
  provider = "prisma-client"
  output   = "../../server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Framework-level metadata only; business entities begin in later tasks.
model AppMetadata {
  key       String   @id @db.Text
  value     Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_metadata")
}

model User {
  id                   String             @id @default(uuid()) @db.Uuid
  wechatOpenid         String             @unique @map("wechat_openid") @db.VarChar(128)
  wechatUnionid        String?            @map("wechat_unionid") @db.VarChar(128)
  displayName          String?            @map("display_name") @db.VarChar(100)
  avatarMediaId        String?            @map("avatar_media_id") @db.Uuid
  status               String             @default("ACTIVE") @db.VarChar(32)
  lastLoginAt          DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions             Session[]
  ownedFamilies        Family[]           @relation("FamilyOwner")
  createdFamilies      Family[]           @relation("FamilyCreator")
  memberships          FamilyMembership[]
  createdPersons       Person[]           @relation("PersonCreator")
  deletedPersons       Person[]           @relation("PersonDeleter")
  createdRelationships Relationship[]     @relation("RelationshipCreator")
  createdPartnerUnions PartnerUnion[]     @relation("PartnerUnionCreator")
  deletedPartnerUnions PartnerUnion[]     @relation("PartnerUnionDeleter")
  personClaims         PersonClaim[]

  @@map("users")
}

model Family {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @db.VarChar(100)
  description          String?            @db.Text
  originPlace          String?            @map("origin_place") @db.VarChar(200)
  ownerUserId          String             @map("owner_user_id") @db.Uuid
  status               String             @default("ACTIVE") @db.VarChar(32)
  privacyPolicyVersion Int                @default(1) @map("privacy_policy_version")
  createdBy            String             @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(6)
  owner                User               @relation("FamilyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  creator              User               @relation("FamilyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  memberships          FamilyMembership[]
  persons              Person[]
  relationships        Relationship[]
  partnerUnions        PartnerUnion[]
  personClaims         PersonClaim[]

  @@index([status])
  @@map("families")
}

model Person {
  id                  String         @id @default(uuid()) @db.Uuid
  familyId            String         @map("family_id") @db.Uuid
  primaryName         String         @map("primary_name") @db.VarChar(100)
  formerName          String?        @map("former_name") @db.VarChar(100)
  courtesyName        String?        @map("courtesy_name") @db.VarChar(100)
  gender              String         @default("UNKNOWN") @db.VarChar(16)
  isLiving            String         @default("UNKNOWN") @map("is_living") @db.VarChar(16)
  birthDate           DateTime?      @map("birth_date") @db.Date
  birthDatePrecision  String?        @map("birth_date_precision") @db.VarChar(16)
  deathDate           DateTime?      @map("death_date") @db.Date
  deathDatePrecision  String?        @map("death_date_precision") @db.VarChar(16)
  birthPlace          String?        @map("birth_place") @db.VarChar(200)
  summary             String?        @db.Text
  isPlaceholder       Boolean        @default(false) @map("is_placeholder")
  placeholderLabel    String?        @map("placeholder_label") @db.VarChar(200)
  status              String         @default("ACTIVE") @db.VarChar(16)
  mergedIntoPersonId  String?        @map("merged_into_person_id") @db.Uuid
  createdBy           String         @map("created_by") @db.Uuid
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?        @map("deleted_by") @db.Uuid
  family              Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator             User           @relation("PersonCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter             User?          @relation("PersonDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)
  mergedInto          Person?        @relation("PersonMerge", fields: [mergedIntoPersonId], references: [id], onDelete: Restrict)
  mergedPersons       Person[]       @relation("PersonMerge")
  parentRelationships Relationship[] @relation("RelationshipParent")
  childRelationships  Relationship[] @relation("RelationshipChild")
  partnerUnionsA      PartnerUnion[] @relation("PartnerUnionPersonA")
  partnerUnionsB      PartnerUnion[] @relation("PartnerUnionPersonB")
  claims              PersonClaim[]

  @@index([familyId, status])
  @@index([familyId, primaryName])
  @@index([mergedIntoPersonId])
  @@map("persons")
}

model PersonClaim {
  id               String   @id @default(uuid()) @db.Uuid
  familyId         String   @map("family_id") @db.Uuid
  personId         String   @map("person_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  claimType        String   @default("SELF") @map("claim_type") @db.VarChar(16)
  status           String   @db.VarChar(16)
  evidenceSourceId String?  @map("evidence_source_id") @db.Uuid
  reviewId         String?  @map("review_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  family           Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person           Person   @relation(fields: [personId], references: [id], onDelete: Restrict)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([familyId, status])
  @@index([userId, status])
  @@index([personId, status])
  @@map("person_claims")
}

model PartnerUnion {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  personAId String    @map("person_a_id") @db.Uuid
  personBId String    @map("person_b_id") @db.Uuid
  unionType String    @default("UNKNOWN") @map("union_type") @db.VarChar(24)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("ACTIVE") @db.VarChar(16)
  sourceId  String?   @map("source_id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  personA   Person    @relation("PartnerUnionPersonA", fields: [personAId], references: [id], onDelete: Restrict)
  personB   Person    @relation("PartnerUnionPersonB", fields: [personBId], references: [id], onDelete: Restrict)
  creator   User      @relation("PartnerUnionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  deleter   User?     @relation("PartnerUnionDeleter", fields: [deletedBy], references: [id], onDelete: Restrict)

  @@index([familyId, personAId, status])
  @@index([familyId, personBId, status])
  @@map("partner_unions")
}

model Relationship {
  id           String    @id @default(uuid()) @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  fromPersonId String    @map("from_person_id") @db.Uuid
  toPersonId   String    @map("to_person_id") @db.Uuid
  type         String    @default("PARENT_OF") @db.VarChar(32)
  parentRole   String    @default("UNKNOWN") @map("parent_role") @db.VarChar(16)
  status       String    @default("ACTIVE") @db.VarChar(16)
  sourceId     String?   @map("source_id") @db.Uuid
  validFrom    DateTime? @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  createdBy    String    @map("created_by") @db.Uuid
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent       Person    @relation("RelationshipParent", fields: [fromPersonId], references: [id], onDelete: Restrict)
  child        Person    @relation("RelationshipChild", fields: [toPersonId], references: [id], onDelete: Restrict)
  creator      User      @relation("RelationshipCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([familyId, fromPersonId, status])
  @@index([familyId, toPersonId, status])
  @@map("relationships")
}

model FamilyMembership {
  id           String    @id @default(uuid()) @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  role         String    @db.VarChar(32)
  status       String    @db.VarChar(32)
  joinedAt     DateTime? @map("joined_at") @db.Timestamptz(6)
  invitationId String?   @map("invitation_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  family       Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([familyId, userId])
  @@index([userId, status])
  @@index([familyId, status])
  @@map("family_memberships")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  accessExpiresAt  DateTime  @map("access_expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime  @map("refresh_expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}
