# Runtime mode only. Add service-specific variables in the task that introduces them.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local development database. Never reuse production credentials in tests.
DATABASE_URL=postgresql://digital_family_tree:digital_family_tree@127.0.0.1:5432/digital_family_tree
TEST_DATABASE_URL=postgresql://digital_family_tree:digital_family_tree@127.0.0.1:5432/postgres

# Development defaults to the deterministic fake provider. Production must use
# "wechat" and provide both credentials.
WECHAT_LOGIN_PROVIDER=fake
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
