page {
  min-height: 100%;
  background: #f6f1e7;
  color: #26322b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view,
button,
text,
input,
textarea {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 160rpx;
}

.eyebrow {
  color: #a46b42;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 10rpx;
  font-family: "Songti SC", serif;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.muted {
  color: #7b817b;
}

.card {
  border: 1rpx solid rgba(57, 75, 64, 0.08);
  border-radius: 28rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 36rpx rgba(55, 65, 58, 0.06);
}

.section-title {
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}

.primary-button,
.secondary-button {
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  background: #315e49;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #315e49;
  background: transparent;
  color: #315e49;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  background: #edf3ee;
  color: #315e49;
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill--warm {
  background: #fff0dc;
  color: #a45c26;
}
