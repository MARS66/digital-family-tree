.tree-head,
.parents,
.couple-row,
.children,
.protected {
  display: flex;
  align-items: center;
}
.tree-head {
  justify-content: space-between;
}
.add {
  margin: 0;
  padding: 0 26rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #315e49;
  color: #fff;
  font-size: 25rpx;
  line-height: 68rpx;
}
.mode-switch {
  display: flex;
  margin-top: 30rpx;
  padding: 6rpx;
  border-radius: 28rpx;
  background: #e8e3d8;
}
.mode {
  flex: 1;
  padding: 18rpx 4rpx;
  border-radius: 23rpx;
  color: #747a74;
  text-align: center;
  font-size: 24rpx;
}
.mode--active {
  background: #fffdf8;
  color: #2f493b;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(39, 54, 45, 0.08);
}
.hint {
  margin: 22rpx 0 34rpx;
  color: #888d86;
  font-size: 22rpx;
  text-align: center;
}
.generation-label {
  margin: 20rpx 0;
  color: #a46b42;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
}
.parents,
.couple-row,
.children {
  justify-content: center;
}
.person-node {
  width: 190rpx;
  padding: 16rpx 10rpx;
  border: 1rpx solid #e3ded3;
  border-radius: 26rpx;
  background: #fffdf8;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(45, 60, 51, 0.05);
}
.node-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin: 0 auto 10rpx;
  border-radius: 39rpx;
  background: #e5e9e2;
  color: #425348;
  font-family: "Songti SC", serif;
  font-size: 31rpx;
}
.male {
  background: #dce9e2;
  color: #315e49;
}
.female {
  background: #f4e2dd;
  color: #9a5c4e;
}
.child {
  background: #eee6cf;
  color: #8a6a2f;
}
.node-name {
  font-size: 27rpx;
  font-weight: 700;
}
.node-meta {
  margin-top: 5rpx;
  color: #858a84;
  font-size: 20rpx;
}
.relation-line {
  width: 42rpx;
  height: 2rpx;
  background: #b8aa93;
}
.vertical-line {
  width: 2rpx;
  height: 48rpx;
  margin: 0 auto;
  background: #b8aa93;
}
.vertical-line.short {
  height: 38rpx;
}
.heart {
  width: 84rpx;
  color: #9b6b55;
  font-size: 19rpx;
  line-height: 1.4;
  text-align: center;
}
.focus {
  border: 3rpx solid #527962;
  background: #f7fbf7;
}
.children {
  gap: 12rpx;
}
.children .person-node {
  width: 202rpx;
}
.placeholder {
  border-style: dashed;
  background: transparent;
  box-shadow: none;
}
.placeholder .node-avatar {
  background: #e7e2d7;
}
.protected {
  margin-top: 38rpx;
  padding: 24rpx;
}
.lock {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #ece9e3;
  color: #797d78;
  font-weight: 700;
}
.protected__copy {
  flex: 1;
  margin-left: 18rpx;
}
.protected__copy .muted {
  margin-top: 5rpx;
  font-size: 21rpx;
}
.chevron {
  color: #8c908a;
}
.privacy-note {
  margin: 12rpx 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ebe7de;
  color: #70766f;
  font-size: 22rpx;
  line-height: 1.6;
}
.lineage-summary {
  display: flex;
  margin-bottom: 30rpx;
  padding: 24rpx 8rpx;
}
.lineage-summary > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #ebe6dc;
  color: #7b817b;
  font-size: 20rpx;
}
.lineage-summary > view:last-child {
  border: 0;
}
.lineage-summary text {
  margin-bottom: 5rpx;
  color: #315e49;
  font-family: "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
}
.ancestor-scroll {
  width: calc(100% + 28rpx);
  overflow: hidden;
  white-space: nowrap;
}
.ancestor-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}
.ancestor-row--wide {
  width: max-content;
  padding-right: 28rpx;
}
.person-node.compact {
  display: inline-block;
  width: 158rpx;
  padding: 14rpx 6rpx;
  vertical-align: top;
}
.person-node.compact .node-avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 33rpx;
  font-size: 26rpx;
}
.person-node.compact .node-name {
  font-size: 23rpx;
}
.protected-node {
  background: #f0ede7;
}
.branch-lines {
  display: flex;
  justify-content: space-around;
  width: 70%;
  height: 42rpx;
  margin: 0 auto;
  border-bottom: 2rpx solid #b8aa93;
}
.branch-lines view {
  width: 2rpx;
  background: #b8aa93;
}
.center-node {
  margin: 0 auto;
}
.older-generation {
  margin-top: 30rpx;
  padding: 24rpx;
}
.older-generation__title {
  margin-bottom: 10rpx;
  font-weight: 700;
}
.older-generation__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #eee9df;
}
.older-generation__row .muted {
  margin-top: 5rpx;
  font-size: 20rpx;
}
.older-generation__row button {
  margin: 0;
  padding: 0 20rpx;
  height: 58rpx;
  border-radius: 29rpx;
  background: #e4ece6;
  color: #315e49;
  font-size: 22rpx;
  line-height: 58rpx;
}
.expand-button {
  margin-top: 26rpx;
  border: 1rpx dashed #83958a;
  border-radius: 38rpx;
  background: transparent;
  color: #315e49;
  font-size: 24rpx;
}
.descendant-trunk {
  width: 2rpx;
  height: 42rpx;
  margin: 0 auto;
  background: #b8aa93;
}
.family-branch {
  margin-bottom: 18rpx;
  overflow: hidden;
}
.branch-head {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.branch-index {
  color: #a46b42;
  font-family: serif;
  font-size: 22rpx;
  font-weight: 700;
}
.branch-head__copy {
  flex: 1;
  margin-left: 18rpx;
  font-weight: 700;
}
.branch-head__copy .muted {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 400;
}
.branch-content {
  padding: 22rpx;
  border-top: 1rpx solid #eee9df;
  background: #fbf9f3;
}
.couple-inline,
.mini-person,
.descendant-children {
  display: flex;
  align-items: center;
}
.couple-inline {
  justify-content: center;
}
.mini-person {
  flex: 1;
  font-weight: 700;
}
.mini-person .node-avatar {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  margin: 0 12rpx 0 0;
  border-radius: 32rpx;
  font-size: 24rpx;
}
.neutral {
  background: #e4e1ea;
  color: #625a77;
}
.partner-dash {
  margin: 0 14rpx;
  color: #a9967b;
}
.protected-mini {
  color: #737973;
}
.descendant-children {
  justify-content: center;
  gap: 18rpx;
}
